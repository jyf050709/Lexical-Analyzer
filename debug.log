.text

.globl leafFunc
leafFunc:
	addi sp, sp, -160
	sw ra, 156(sp)
	sw s0, 152(sp)
	addi s0, sp, 160
	sw a0, -12(s0)
	sw a1, -16(s0)
	lw t0, -12(s0)
	addi sp, sp, -4
	sw t0, 0(sp)
	lw t0, -16(s0)
	mv t1, t0
	lw t0, 0(sp)
	addi sp, sp, 4
	add t0, t0, t1
	sw t0, -24(s0)
	lw t0, -12(s0)
	addi sp, sp, -4
	sw t0, 0(sp)
	lw t0, -16(s0)
	mv t1, t0
	lw t0, 0(sp)
	addi sp, sp, 4
	sub t0, t0, t1
	sw t0, -28(s0)
	lw t0, -24(s0)
	addi sp, sp, -4
	sw t0, 0(sp)
	lw t0, -28(s0)
	mv t1, t0
	lw t0, 0(sp)
	addi sp, sp, 4
	mul t0, t0, t1
	sw t0, -32(s0)
	lw t0, -32(s0)
	mv a0, t0
	lw ra, 156(sp)
	lw s0, 152(sp)
	addi sp, sp, 160
	ret

.globl nonLeafFunc
nonLeafFunc:
	addi sp, sp, -144
	sw ra, 140(sp)
	sw s0, 136(sp)
	addi s0, sp, 144
	sw a0, -12(s0)
	lw t0, -12(s0)
	addi sp, sp, -4
	sw t0, 0(sp)
	li t0, 1
	mv t1, t0
	lw t0, 0(sp)
	addi sp, sp, 4
	slt t0, t1, t0
	xori t0, t0, 1
	beqz t0, L0
	lw t0, -12(s0)
	mv a0, t0
	lw ra, 140(sp)
	lw s0, 136(sp)
	addi sp, sp, 144
	ret
L0:
	addi sp, sp, -8
	lw t0, -12(s0)
	sw t0, 0(sp)
	lw t0, -12(s0)
	addi sp, sp, -4
	sw t0, 0(sp)
	li t0, 1
	mv t1, t0
	lw t0, 0(sp)
	addi sp, sp, 4
	sub t0, t0, t1
	sw t0, 4(sp)
	lw a0, 0(sp)
	lw a1, 4(sp)
	addi sp, sp, 8
	call leafFunc
	mv t0, a0
	mv a0, t0
	lw ra, 140(sp)
	lw s0, 136(sp)
	addi sp, sp, 144
	ret

