	mv t1, t0
	lw t0, 0(sp)
	addi sp, sp, 4
	add t0, t0, t1
	sw t0, -24(s0)
	j L2
L3:
	lw t0, -20(s0)
	mv a0, t0
	lw ra, 156(sp)
	lw s0, 152(sp)
	addi sp, sp, 160
	ret

